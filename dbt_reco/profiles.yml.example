# Copy sang ~/.dbt/profiles.yml
dbt_reco:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      password: "{{ env_var('SNOWFLAKE_PASSWORD') }}"
      role: RECO_ROLE
      warehouse: RECO_WH
      database: RECO
      schema: ANALYTICS
      threads: 4
